    "Tap + to send PDFs, photos, Word, Excel or text files to your Apple Watch. You can also use “Send to Watch” in the share sheet." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez + pour envoyer des PDF, photos, fichiers Word, Excel ou texte vers votre Apple Watch. Vous pouvez aussi utiliser « Envoyer vers la montre » dans la feuille de partage."
          }
        }
      }
    },
